    <!-- Model is a support Lua module included by the overview panel. -->
    <ImportFiles id="EC_OverviewModelFile">
      <File>UI/EC_OverviewModel.lua</File>
    </ImportFiles>
    <!-- Keep the previously discovered action IDs so an in-process mod
         reload can reuse Civ VI's existing action graph.  The overview
         contexts remain separate and append-only, with late load orders so
         common third-party LaunchBar additions are already present. -->
    <AddUserInterfaces id="EC_ConsentUI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>29999</LoadOrder>
      </Properties>
      <File>UI/EC_ConsentPopup.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="EC_MetricBridgeUI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>29998</LoadOrder>
      </Properties>
      <File>UI/EC_MetricBridge.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="EC_ProductionBridgeUI">
      <Properties><Context>InGame</Context><LoadOrder>29997</LoadOrder></Properties>
      <File>UI/EC_ProductionBridge.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="EC_OverviewLaunchUI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>30000</LoadOrder>
      </Properties>
      <File>UI/EC_OverviewLaunch.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="EC_OverviewPanelUI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>30001</LoadOrder>
      </Properties>
      <File>UI/EC_OverviewPanel.xml</File>
    </AddUserInterfaces>
