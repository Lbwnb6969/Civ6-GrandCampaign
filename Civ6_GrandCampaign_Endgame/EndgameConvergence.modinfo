<?xml version="1.0" encoding="utf-8"?>
<Mod id="2af0c438-bab0-4d0c-987f-0beaf0f7c7f2" version="1">
  <Properties>
    <Name>后期终局：附庸与觉醒</Name>
    <Description>默认观测文明实力与觉醒条件，可选影子附庸演练、项目加成和觉醒战争实验；真实附庸移交与胜利限制仍待原生验证。</Description>
    <Created>1790849000</Created>
  <Teaser>默认只观测；影子附庸、项目加成和觉醒实验需单独开启。</Teaser>
    <Authors>Haikesi 项目</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <References>
    <Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="Expansion: Rise and Fall" />
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </References>
  <ActionCriteria>
    <Criteria id="EC_NATIVE_VICTORY_MODE">
      <ConfigurationValueMatches><Group>Game</Group><ConfigurationId>EC_AWAKENING_ACTIONS_TEST</ConfigurationId><Value>1</Value></ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_NATIVE_VASSAL_MODE">
      <ConfigurationValueMatches>
        <Group>Game</Group><ConfigurationId>EC_NATIVE_VASSAL_TEST</ConfigurationId><Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_NATIVE_LIFECYCLE_PROBE">
      <ConfigurationValueMatches>
        <Group>Game</Group><ConfigurationId>EC_NATIVE_LIFECYCLE_TEST</ConfigurationId><Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_NATIVE_LIFECYCLE_MARKER_PROBE">
      <ConfigurationValueMatches>
        <Group>Game</Group><ConfigurationId>EC_NATIVE_LIFECYCLE_TEST</ConfigurationId><Value>2</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_AI_MILITARY_PRODUCTION">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>EC_AI_MILITARY_PRODUCTION_TEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_AI_MILITARY_PRODUCTION_ONLINE">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>EC_AI_MILITARY_PRODUCTION_TEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAME_SPEED_TYPE</ConfigurationId>
        <Value>GAMESPEED_ONLINE</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_AI_MILITARY_PRODUCTION_QUICK">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>EC_AI_MILITARY_PRODUCTION_TEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAME_SPEED_TYPE</ConfigurationId>
        <Value>GAMESPEED_QUICK</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_AI_MILITARY_PRODUCTION_STANDARD">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>EC_AI_MILITARY_PRODUCTION_TEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAME_SPEED_TYPE</ConfigurationId>
        <Value>GAMESPEED_STANDARD</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_AI_MILITARY_PRODUCTION_EPIC">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>EC_AI_MILITARY_PRODUCTION_TEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAME_SPEED_TYPE</ConfigurationId>
        <Value>GAMESPEED_EPIC</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="EC_AI_MILITARY_PRODUCTION_MARATHON">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>EC_AI_MILITARY_PRODUCTION_TEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAME_SPEED_TYPE</ConfigurationId>
        <Value>GAMESPEED_MARATHON</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
  <FrontEndActions>
    <UpdateDatabase id="EC_Config">
      <File>Data/EC_Config_FE.sql</File>
    </UpdateDatabase>
    <UpdateText id="EC_FrontEndText">
      <File>Text/EC_Text.xml</File>
    </UpdateText>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="EC_NativeVictoryRules">
      <Criteria>EC_NATIVE_VICTORY_MODE</Criteria>
      <Properties><LoadOrder>19000</LoadOrder></Properties>
      <File>Data/EC_VictoryRules.sql</File>
    </UpdateDatabase>
    <UpdateIcons id="EC_NativeVictoryIcons"><Criteria>EC_NATIVE_VICTORY_MODE</Criteria><File>Data/EC_VictoryIcons.xml</File></UpdateIcons>
