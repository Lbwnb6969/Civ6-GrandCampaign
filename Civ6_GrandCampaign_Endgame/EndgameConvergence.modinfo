      <Criteria>EC_NATIVE_LIFECYCLE_MARKER_PROBE</Criteria>
      <File>Data/EC_LifecycleIcons.xml</File>
    </UpdateIcons>
    <UpdateText id="EC_InGameText">
      <File>Text/EC_Text.xml</File>
    </UpdateText>
    <UpdateDatabase id="EC_ProjectEffects">
      <File>Data/EC_ProjectEffects.xml</File>
    </UpdateDatabase>
    <UpdateDatabase id="EC_AwakeningEffects">
      <File>Data/EC_AwakeningEffects.xml</File>
    </UpdateDatabase>
