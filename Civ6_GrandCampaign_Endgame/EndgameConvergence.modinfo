    <AddGameplayScripts id="EC_Gameplay">
      <Properties>
        <LoadOrder>16910</LoadOrder>
      </Properties>
      <File>GamePlay/EC_GamePlay.lua</File>
    </AddGameplayScripts>
    <ImportFiles id="EC_RuleFiles">
      <File>GamePlay/EC_AIProductionCredit.lua</File>
      <File>GamePlay/EC_HumanProductionRefund.lua</File>
      <File>GamePlay/EC_ProductionArchive.lua</File>
